# Database Configuration
DB_NAME=probe_game
DB_USER=probe_user
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

# Application Configuration
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5200

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:5200,http://localhost:3000

# Socket.io
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Dictionary
DICTIONARY_PATH=./data/dictionary.txt

# LLM Bot Configuration (see backend/.env.example for details)
# Default bot provider: ollama | openrouter | lmstudio (local LM Studio models)
LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_TIMEOUT_MS=55000
LMSTUDIO_MIN_MAX_TOKENS=2048
LMSTUDIO_REASONING_EFFORT=low
OPENROUTER_API_KEY=
