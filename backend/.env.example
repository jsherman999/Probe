NODE_ENV=development
PORT=3000

# Database Configuration
# Change the password for production!
DATABASE_URL=postgresql://probe_user:probe_password@localhost:5432/probe_game

# JWT Configuration
# IMPORTANT: Generate new secrets for production using:
# openssl rand -base64 64
JWT_SECRET=development_jwt_secret_change_in_production_minimum_32_chars
REFRESH_TOKEN_SECRET=development_refresh_secret_change_in_production_minimum_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5200,http://localhost:3000

# Game Configuration
MAX_PLAYERS_PER_GAME=4
MIN_PLAYERS_PER_GAME=2
WORD_MIN_LENGTH=4
WORD_MAX_LENGTH=12
TURN_TIMEOUT_SECONDS=60

# LLM Bot Configuration
# Default provider used when a bot request doesn't specify one: ollama | openrouter | lmstudio
# Set to "lmstudio" to use models loaded in a local LM Studio instance.
LLM_PROVIDER=lmstudio

# LM Studio (OpenAI-compatible API) - local models, no cloud required
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Generation timeout in ms (keep under TURN_TIMEOUT_SECONDS)
LMSTUDIO_TIMEOUT_MS=55000
# Floor for max_completion_tokens. Thinking models spend their token budget on
# reasoning, so a small num_predict would otherwise yield empty content.
LMSTUDIO_MIN_MAX_TOKENS=2048
# OpenAI-standard reasoning control (honored by models like gpt-oss): low | medium | high
LMSTUDIO_REASONING_EFFORT=low

# OpenRouter (optional, cloud models)
OPENROUTER_API_KEY=
